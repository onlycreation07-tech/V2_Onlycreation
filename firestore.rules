rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Users ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Organizations ---
    match /organizations/{organizationId} {
      allow read: if isOwner(existing().ownerId) || isAdmin();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if (isOwner(existing().ownerId) || isAdmin()) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }

    // --- Projects ---
    match /projects/{id} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isOwner(existing().userId) || isAdmin();
      allow update: if (isOwner(existing().userId) || isAdmin()) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // --- Messages ---
    match /messages/{messageId} {
      function projectOwner() {
        return isSignedIn() && get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.userId == request.auth.uid;
      }
      allow read: if projectOwner() || isAdmin();
      allow create, update, delete: if false;
    }

    // --- Activity Logs ---
    match /activityLogs/{logId} {
      allow create: if isSignedIn() && incoming().performedBy == request.auth.uid;
      allow read: if isOwner(existing().performedBy) || isAdmin();
      allow update, delete: if false;
    }

    // --- Admins (Role escalation prevention) ---
    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // --- Dispatches ---
    match /dispatches/{id} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isOwner(existing().userId) || isAdmin();
      allow update: if (isOwner(existing().userId) || isAdmin()) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // --- Bookings (Locked against price manipulation) ---
    match /bookings/{id} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow write: if false;
    }

    // --- Booking Locks (Concurrency safe double-booking prevention) ---
    match /bookingLocks/{lockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Production Briefs ---
    match /productionBriefs/{briefId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Shoot Sets & Curated Bundles ---
    match /shootSets/{setId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Brands ---
    match /brands/{id} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isOwner(existing().userId) || isAdmin();
      allow update: if (isOwner(existing().userId) || isAdmin()) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // --- Creatives ---
    match /creatives/{id} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isOwner(existing().userId) || isAdmin();
      allow update: if (isOwner(existing().userId) || isAdmin()) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // --- Studios ---
    match /studios/{studioId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- App Config ---
    match /config/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Enquiries ---
    match /enquiries/{enquiryId} {
      allow create: if isSignedIn();
      allow get, list: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Wallets (Strict server-authoritative, client read-only) ---
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // --- Ledger Entries (Double-Entry, Strictly Immutable) ---
    match /ledgerEntries/{entryId} {
      allow get: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // --- Payments (Authoritative status and tamper-proof) ---
    match /payments/{id} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow write: if false;
    }

    // --- Partner Payouts (Server/Admin controlled) ---
    match /payouts/{payoutId} {
      allow get, list: if isSignedIn() && (resource.data.partnerId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // --- Partner Profiles ---
    match /partnerProfiles/{partnerId} {
      allow read: if isOwner(partnerId) || isAdmin();
      allow write: if false;
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(existing().authorId) || isAdmin();
    }

    // --- Disputes ---
    match /disputes/{disputeId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.raisedBy == request.auth.uid || resource.data.raisedAgainst == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
